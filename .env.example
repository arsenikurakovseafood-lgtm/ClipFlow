# Reserved for the future service. The standalone renderer makes no provider calls.
CLIPFLOW_PAID_WORKLOADS_ENABLED=false

# Private cloud preview gateway. Set a real hostname when deploying with TLS.
CLIPFLOW_SITE=http://localhost
CLIPFLOW_BIND_IP=127.0.0.1
CLIPFLOW_HTTP_PORT=80
CLIPFLOW_HTTPS_PORT=443
CLIPFLOW_OWNER=owner
# Set a real Caddy bcrypt hash via the cloud secret store. Keep this blank in Git.
CLIPFLOW_OWNER_HASH=

# Supabase owner sign-in. Use a pre-provisioned user and a dedicated session secret.
CLIPFLOW_SUPABASE_URL=
CLIPFLOW_SUPABASE_KEY=
CLIPFLOW_OWNER_ID=
CLIPFLOW_SESSION_SECRET=

# R2 private bucket and scoped S3 credentials. Never use the global API key.
CLIPFLOW_R2_ACCOUNT_ID=
CLIPFLOW_R2_BUCKET=
CLIPFLOW_R2_ACCESS_KEY_ID=
CLIPFLOW_R2_SECRET_ACCESS_KEY=

# OpenAI captions. Enable paid workloads explicitly after approving USD limits.
OPENAI_API_KEY=
CLIPFLOW_TRANSCRIPTION_MONTHLY_MICRO_USD=0

# Retention for finished jobs, measured from completion.
CLIPFLOW_SOURCE_RETENTION_HOURS=24
CLIPFLOW_OUTPUT_RETENTION_HOURS=168

# Separate whole-workspace monthly cap for AI draft creation.
CLIPFLOW_PLANNING_MONTHLY_MICRO_USD=0

# Optional restricted YouTube Data API key for public owner-reported post statistics.
CLIPFLOW_YOUTUBE_DATA_API_KEY=
